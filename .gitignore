# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# uploaded/exported media (large binaries)
public/uploads/
public/exports/
public/analysis/

# temporary artifacts
render-log.txt
test-results.json

# claude/gstack
.claude/launch.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Python envs + downloaded model weights (large / regenerable)
scripts/python/.venv/
scripts/python/.venv-vision/
scripts/python/.torch/
scripts/python/models/

# Scratch / tooling
*.log
.test-*.log
.claude-flow/
.swarm/
.claude/
